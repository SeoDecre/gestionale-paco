# Copiare in .env.local e compilare dal progetto Supabase
# (Dashboard → Project Settings → API).
#
# La anon key finisce nel bundle JS ed è pubblica per definizione:
# a proteggere i dati è la RLS, non la segretezza di questa chiave.
# La service_role key non va MAI messa qui: sta solo nelle Edge Function.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
